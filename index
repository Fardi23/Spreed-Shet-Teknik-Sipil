function parseBulk(text) {
  const out = [], errs = [];
  text.split(/\r?\n/).forEach((line, i) => {
    if (!line.trim()) return;
    let parts = line.split(/\t|;/).map(s => s.trim()).filter(Boolean);
    if (parts.length < 3) parts = line.split(',').map(s => s.trim()).filter(Boolean);
    if (parts.some(p => /^nama$/i.test(p)) && parts.some(p => /^e-?mail$/i.test(p))) return; // baris judul
    const e = parts.find(p => p.includes('@'));
    const rest = parts.filter(p => p !== e);
    const nim = rest.find(p => (p.match(/\d/g) || []).length >= 3);
    const n = rest.filter(p => p !== nim).join(', ');
    if (!e || !nim || !n) errs.push('Baris ' + (i + 1) + ': perlu Nama, Email, dan NIM.');
    else out.push({ n, e, nim, line: i + 1 });
  });
  return { out, errs };
}
