  const v = await modal({
    title: made.length + ' akun ditambahkan',
    html: '<p>Password dibuat otomatis untuk setiap akun. Unduh daftarnya untuk dibagikan ke mahasiswa, atau lihat langsung di tabel daftar akun.</p>',
    actions: [{ label: 'Tutup', v: 'cancel' }, { label: 'Unduh daftar akun (CSV)', v: 'ok', cls: 'primary' }]
  });
  if (v === 'ok') downloadCSV(made);
});

function csv(list) {
  const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
  const lines = [['Nama', 'Email', 'NIM', 'Username', 'Password', 'Peran'].map(q).join(';')]
    .concat(list.map(a => [a.n, a.e, a.nim, a.u, a.r === 'admin' ? '' : (VAULT[a.u] || ''), roleLabel(a.r)].map(q).join(';')));
  return '﻿' + lines.join('\r\n');
}
function downloadCSV(list) {
  list = list || DB.accounts.filter(a => a.r !== 'admin');
  if (!list.length) { toast('Belum ada akun mahasiswa.'); return; }
  download('Daftar-Akun-Lembar-Hitung-Sipil.csv', csv(list), 'text/csv;charset=utf-8');
}
$('#a-csv').addEventListener('click', () => downloadCSV());

async function resetPassword(a) {
  await modal({
    title: 'Reset password ' + a.n,
    html: '<label class="fld"><span>Password baru</span><input class="inp" name="pw" autocomplete="new-password" placeholder="Kosongkan agar dibuat otomatis"></label>' +
      '<p class="hint">Password lama langsung tidak berlaku di file yang Anda unduh berikutnya.</p>',
    actions: [{ label: 'Batal', v: 'cancel' }, { label: 'Reset password', v: 'ok', cls: 'primary' }],
    onOk: async f => {
      const pw = f.pw.value.trim() || genPw();
      if (pw.length < (a.r === 'admin' ? 8 : 6)) throw 'Password minimal ' + (a.r === 'admin' ? 8 : 6) + ' karakter.';
      const rec = await makeRecord(a, pw, a);
      DB.accounts[DB.accounts.indexOf(a)] = rec;
      if (a.r !== 'admin') { VAULT[a.u] = pw; await saveVault(); }
      persist(); renderAdmin();
      setTimeout(() => showCred(rec, pw, 'Password baru untuk ' + a.n), 0);
    }
  });
}
async function deleteAccount(a) {
  if (a.u === S.u) { toast('Akun yang sedang dipakai tidak bisa dihapus.'); return; }
  if (a.r === 'admin' && DB.accounts.filter(x => x.r === 'admin').length <= 1) { toast('Minimal harus ada satu admin.'); return; }
  const ok = await confirmBox('Hapus akun ' + a.n + '?', 'Akun ' + esc(a.nim || a.u) + ' tidak bisa dipakai lagi di file yang Anda unduh berikutnya.', 'Hapus akun', true);
  if (!ok) return;
  DB.accounts = DB.accounts.filter(x => x !== a);
  if (VAULT[a.u] != null) { delete VAULT[a.u]; await saveVault(); }
  persist(); renderAdmin(); toast('Akun ' + a.n + ' dihapus.');
}
async function editProfile(a) {
  const stu = a.r !== 'admin';
  await modal({
    title: a.u === S.u ? 'Ubah nama dan email saya' : 'Ubah akun ' + a.n,
    html: '<label class="fld"><span>Nama lengkap</span><input class="inp" name="n" value="' + esc(a.n) + '"></label>' +
      (stu ? '<label class="fld"><span>NIM</span><input class="inp" name="nim" value="' + esc(a.nim) + '"></label>' : '') +
      '<label class="fld"><span>Email</span><input class="inp" name="e" type="email" value="' + esc(a.e) + '"></label>' +
      (stu ? '<p class="hint">NIM juga dipakai sebagai username. Password tidak berubah.</p>' : ''),
    actions: [{ label: 'Batal', v: 'cancel' }, { label: 'Simpan', v: 'ok', cls: 'primary' }],
    onOk: async f => {
      const n = f.n.value.trim().replace(/\s+/g, ' '), e = f.e.value.trim();
      if (stu) {
        const v = checkStudent({ n, e, nim: f.nim.value }, a.u);
        if (v.u !== a.u) {
          let pw = VAULT[a.u], fresh = false;
          if (!pw) { pw = genPw(); fresh = true; }
          const rec = await makeRecord({ u: v.u, n: v.n, e: v.e, nim: v.nim, r: 'mahasiswa' }, pw, a);
          DB.accounts[DB.accounts.indexOf(a)] = rec; delete VAULT[a.u]; VAULT[v.u] = pw; await saveVault();
          persist(); renderAdmin();
          if (fresh) setTimeout(() => showCred(rec, pw, 'Password baru untuk ' + rec.n), 0);
          return;
        }
        a.n = v.n; a.e = v.e; a.nim = v.nim;
      } else {
        if (n.length < 2) throw 'Isi nama lengkap.';
        if (e && !isEmail(e)) throw 'Alamat email belum benar.';
        if (e && DB.accounts.some(x => x !== a && x.e && x.e.toLowerCase() === e.toLowerCase())) throw 'Email sudah dipakai akun lain.';
        a.n = n; a.e = e;
      }
      persist(); renderAdmin(); renderMe(); if (current === 'home') renderHome();
    }
  });
}
async function changeMyPassword() {
  const a = me();
  await modal({
    title: 'Ganti password saya',
    html: '<label class="fld"><span>Password baru (minimal 8 karakter)</span><input class="inp" name="p1" type="password" autocomplete="new-password"></label>' +
      '<label class="fld"><span>Ulangi password baru</span><input class="inp" name="p2" type="password" autocomplete="new-password"></label>' +
      '<p class="hint">Password baru berlaku di file yang Anda unduh setelah ini. Simpan password ini baik-baik: tanpa password admin, akun tidak bisa dikelola lagi.</p>',
    actions: [{ label: 'Batal', v: 'cancel' }, { label: 'Simpan password', v: 'ok', cls: 'primary' }],
    onOk: async f => {
      const p1 = f.p1.value, p2 = f.p2.value;
      if (p1.length < 8) throw 'Password minimal 8 karakter.';
      if (p1 !== p2) throw 'Kedua password belum sama.';
      const rec = await makeRecord(a, p1, a);
      DB.accounts[DB.accounts.indexOf(a)] = rec;
      persist(); renderAdmin(); if (current === 'home') renderHome();
      toast('Password diganti. Unduh file terbaru agar password baru ikut tersimpan di file.', 5000);
    }
  });
}
$('#f-admin').addEventListener('submit', async ev => {
  ev.preventDefault();
  const f = ev.currentTarget, err = $('#adm-err'), btn = $('button[type=submit]', f);
  err.textContent = '';
  const n = f.n.value.trim().replace(/\s+/g, ' '), e = f.e.value.trim(), u = normId(f.u.value), pw = f.pw.value;
  try {
    if (n.length < 2) throw 'Isi nama.';
    if (e && !isEmail(e)) throw 'Alamat email belum benar.';
    if (!/^[a-z0-9._-]{3,40}$/.test(u)) throw 'Username minimal 3 karakter: huruf, angka, titik, atau tanda hubung.';
    if (DB.accounts.some(x => x.u === u || (x.nim && normId(x.nim) === u))) throw 'Username sudah dipakai.';
    if (e && DB.accounts.some(x => x.e && x.e.toLowerCase() === e.toLowerCase())) throw 'Email sudah dipakai akun lain.';
    if (pw.length < 8) throw 'Password admin minimal 8 karakter.';
  } catch (x) { err.textContent = x; return; }
  btn.disabled = true;
  try {
    const rec = await makeRecord({ u, n, e, nim: '', r: 'admin' }, pw);
    DB.accounts.push(rec); persist(); f.reset(); renderAdmin(); toast('Admin ' + n + ' ditambahkan.');
  } catch (x) { err.textContent = 'Gagal: ' + (x && x.message || x); }
  finally { btn.disabled = false; }
});

/* ---------- unduh file untuk dibagikan ---------- */
const FONT_LINK = '<link rel="preconnect" href="https://fonts.googleapis.com">\n<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;700;800&family=Overpass+Mono:wght@400;600&display=swap">';
const NOSCRIPT = '<noscript><p style="padding:24px;font:16px sans-serif">File ini membutuhkan JavaScript. Buka dengan Chrome, Edge, Firefox, atau Safari versi terbaru.</p></noscript>';
function skeleton(db) {
  const S1 = '<scr' + 'ipt', S2 = '</scr' + 'ipt>';
  return '<!DOCTYPE html>\n<html lang="id">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n<meta name="robots" content="noindex">\n<title>Lembar Hitung Sipil</title>\n' +
    FONT_LINK + '\n<style id="lhs-css">' + SRC.css + '</style>\n</head>\n<body>\n' + NOSCRIPT + '\n' +
    S1 + ' type="text/html" id="lhs-ui">' + SRC.ui + S2 + '\n' +
    S1 + ' type="application/json" id="lhs-index">' + SRC.index + S2 + '\n' +
    S1 + ' type="application/octet-stream" id="lhs-payload">' + SRC.payload + S2 + '\n' +
    S1 + ' type="application/json" id="lhs-db">' + JSON.stringify(db).replace(/</g, '\\u003c') + S2 + '\n' +
    S1 + ' id="lhs-app">' + SRC.app + S2 + '\n</body>\n</html>\n';
}
$('#s-go').addEventListener('click', async () => {
  const a = me();
  if (a.def) {
    const ok = await confirmBox('Password bawaan masih dipakai', 'Siapa pun yang tahu password bawaan bisa masuk sebagai admin di file ini. Lanjutkan mengunduh tanpa mengganti password?', 'Tetap unduh');
    if (!ok) return;
  }
  let name = ($('#s-name').value || '').trim().replace(/[\\/:*?"<>|]+/g, '-') || 'Lembar-Hitung-Sipil.html';
  if (!/\.html?$/i.test(name)) name += '.html';
  const db = clone(DB); db.exportedRev = db.rev; db.exported = new Date().toISOString();
  download(name, skeleton(db), 'text/html;charset=utf-8');
  DB.exportedRev = DB.rev; DB.exported = db.exported; persist(false);
  if ($('#s-csv').checked) setTimeout(() => downloadCSV(), 700);
  renderAdmin();
  toast('File ' + name + ' diunduh. Bagikan file ini ke mahasiswa.', 5000);
});
$('#s-revert').addEventListener('click', async () => {
  if (!isDirty() && DB.rev === EMBED.rev) { toast('Tidak ada perubahan yang perlu dibatalkan.'); return; }
  const ok = await confirmBox('Kembalikan daftar akun?', 'Daftar akun dikembalikan ke isi file yang sedang dibuka (revisi ' + EMBED.rev + ').', 'Kembalikan', true);
  if (!ok) return;
  DB = clone(EMBED); store.del(LS, K_DB);
  if (!me()) { logout(); toast('Akun Anda tidak ada di isi file, silakan masuk ulang.'); return; }
  await loadVault(); renderMe(); renderAdmin(); toast('Daftar akun dikembalikan.');
});

/* ---------- mulai ---------- */
renderLoginMeta();
(async () => {
  if (!window.crypto || !crypto.subtle) {
    fatal('Browser tidak mengizinkan enkripsi di tampilan ini. Simpan file ke perangkat, lalu buka langsung dengan Chrome, Edge, Firefox, atau Safari terbaru.');
    $('#l-go').disabled = true; return;
  }
  const s = store.get(SS, K_SESS);
  const acc = s && DB.accounts.find(a => a.u === s.u);
  if (s && acc) {
    try { await startSession(acc, { u: s.u, k: s.k, v: s.v, r: s.r }); return; }
    catch (e) { store.del(SS, K_SESS); }
  } else if (s) store.del(SS, K_SESS);
  $('#l-id').focus();
})();
})();
</script>
