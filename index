<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Lembar Hitung Sipil</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Overpass:wght@400;600;700;800&family=Overpass+Mono:wght@400;600&display=swap">
<style id="lhs-css">
:root{
  --paper:#F5F8F6;--grid:#DDEAE3;--grid2:#BDD8CB;
  --surface:#FFFFFF;--ink:#16202A;--ink2:#4E5C67;--ink3:#7B8892;
  --line:#CDD6DB;--line2:#E5EAED;
  --pen:#1E4F8F;--pen2:#163C6E;--pen-soft:#E7EEF8;
  --mark:#F3C84B;--mark-soft:#FFF6D6;
  --bad:#B42318;--bad-soft:#FDECEA;--ok:#2B7A4B;--warn:#7A5200;--warn-soft:#FFF4D6;
  --font:"Overpass","Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;
  --mono:"Overpass Mono",ui-monospace,"Cascadia Mono",Consolas,monospace;
  --side:304px;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{height:100%}
body{margin:0;font-family:var(--font);font-size:15px;line-height:1.5;color:var(--ink);background:var(--paper);-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--pen);outline-offset:2px}
h1,h2,h3,h4,p{margin:0}
.mm{background-color:var(--paper);
  background-image:linear-gradient(var(--grid2) 1px,transparent 1px),linear-gradient(90deg,var(--grid2) 1px,transparent 1px),
  linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:50px 50px,50px 50px,10px 10px,10px 10px;background-position:-1px -1px}

/* ---------- tombol & isian ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:9px 14px;border:1px solid #9FADB6;background:#fff;border-radius:4px;cursor:pointer;font-weight:600;font-size:14px;line-height:1.2;white-space:nowrap;color:var(--ink);text-decoration:none}
.btn:hover{background:#F0F3F5}
.btn.primary{background:var(--pen);border-color:var(--pen);color:#fff}
.btn.primary:hover{background:var(--pen2);border-color:var(--pen2)}
.btn.danger{color:var(--bad);border-color:#E3B3AE}
.btn.danger:hover{background:var(--bad-soft)}
.btn.ghost{border-color:transparent;background:transparent}
.btn.ghost:hover{background:#EEF2F4}
.btn.sm{padding:5px 9px;font-size:13px}
.btn:disabled{opacity:.55;cursor:progress}
.fld{display:grid;gap:5px;min-width:0}
.fld>span{font-size:13.5px;font-weight:600}
.inp{width:100%;min-width:0;padding:9px 11px;border:1px solid #AEBAC2;border-radius:4px;background:#fff}
.inp:focus{border-color:var(--pen)}
textarea.inp{min-height:150px;resize:vertical;font-family:var(--mono);font-size:13px;line-height:1.5}
.pw{display:flex}
.pw .inp{border-radius:4px 0 0 4px}
.pw button{flex:none;border:1px solid #AEBAC2;border-left:0;background:#F2F5F7;padding:0 12px;border-radius:0 4px 4px 0;font-size:13px;cursor:pointer}
.err{color:var(--bad);font-size:14px;min-height:1.25em}
.err:empty{min-height:0}
.hint{font-size:13px;color:var(--ink2)}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.chk{display:flex;gap:8px;align-items:flex-start;font-size:14px}
.chk input{margin-top:3px}
.cred{font-family:var(--mono);font-size:13px}

/* ---------- login ---------- */
.login{min-height:100vh;display:grid;grid-template-columns:minmax(0,1fr) minmax(330px,440px);gap:clamp(24px,5vw,72px);align-items:center;padding:40px clamp(20px,6vw,96px)}
.sketch{color:var(--pen);max-width:680px;justify-self:end;width:100%}
.sketch svg{width:100%;height:auto;display:block}
.sketch text{font-family:var(--font);fill:currentColor}
.sketch figcaption{margin-top:14px;font-size:14px;color:var(--ink2);max-width:52ch}
.tb-card{background:var(--surface);border:2px solid var(--ink)}
.tb-head{padding:22px 24px 18px;border-bottom:1px solid var(--ink);display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start}
.tb-head h1{font-size:29px;font-weight:800;letter-spacing:-.015em;line-height:1.05}
.tb-head p{margin-top:8px;color:var(--ink2);font-size:14.5px}
.tb-body{padding:20px 24px 22px;display:grid;gap:14px}
.tb-body .btn.primary{padding:11px 14px;font-size:15px}
.tb-foot{display:grid;grid-template-columns:1.35fr .9fr 1.15fr;margin:0;border-top:1px solid var(--ink)}
.tb-foot>div{padding:9px 12px;border-left:1px solid var(--ink);min-width:0}
.tb-foot>div:first-child{border-left:0}
.tb-foot dt{font-size:11.5px;color:var(--ink2)}
.tb-foot dd{margin:2px 0 0;font-size:13px;font-weight:600;line-height:1.3}
.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.fatal{border:1px solid #E3B3AE;background:var(--bad-soft);color:var(--bad);padding:10px 12px;font-size:14px}
@media(max-width:900px){.login{grid-template-columns:1fr;padding:24px 14px}.sketch{display:none}.tb-card{max-width:460px;width:100%;justify-self:center}}
@media(max-width:420px){.tb-foot{grid-template-columns:1fr 1fr}.tb-foot>div:first-child{grid-column:1/-1;border-bottom:1px solid var(--ink)}.tb-foot>div:nth-child(2){border-left:0}}

/* ---------- kerangka aplikasi ---------- */
.app{display:grid;grid-template-columns:var(--side) minmax(0,1fr);height:100vh;height:100dvh}
.side{background:var(--surface);border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
.brand{display:flex;gap:10px;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}
.brand b{display:block;font-size:16px;font-weight:800;line-height:1.15}
.brand span{display:block;font-size:12.5px;color:var(--ink2);line-height:1.3}
.side-top{padding:12px 12px 4px;display:grid;gap:8px}
.home-link{display:flex;align-items:center;gap:8px;width:100%;padding:8px 10px;border:0;border-radius:4px;background:none;cursor:pointer;font-weight:700;text-align:left}
.home-link:hover{background:#F2F5F7}
.home-link[aria-current]{background:var(--mark-soft);box-shadow:inset 3px 0 0 var(--mark)}
.side nav{flex:1;overflow:auto;padding:0 8px 14px}
.grp{margin-top:12px}
.grp h4{font-size:12.5px;font-weight:700;color:var(--ink2);padding:2px 10px 4px}
.item{display:grid;grid-template-columns:24px 1fr auto;gap:8px;align-items:baseline;width:100%;text-align:left;padding:7px 10px;border:0;background:none;border-radius:4px;cursor:pointer;font-size:14px;line-height:1.3}
.item .no{font-variant-numeric:tabular-nums;color:var(--ink3);font-weight:700;font-size:12.5px;text-align:right}
.item .dot{width:7px;height:7px;border-radius:50%;background:transparent;align-self:center}
.item.loaded .dot{background:var(--pen)}
.item:hover{background:#F2F5F7}
.item[aria-current]{background:var(--mark-soft);box-shadow:inset 3px 0 0 var(--mark);font-weight:600}
.item[aria-current] .no{color:var(--ink)}
.me{border-top:1px solid var(--line);padding:12px 14px 14px;display:grid;gap:10px}
.me-id b{display:block;font-size:14px;line-height:1.3}
.me-id span{font-size:12.5px;color:var(--ink2)}
.me .row .btn{flex:1}
.main{display:grid;grid-template-rows:auto minmax(0,1fr);grid-template-columns:minmax(0,1fr);min-width:0;min-height:0}
.bar{display:flex;align-items:center;gap:12px;padding:8px 16px;background:var(--surface);border-bottom:1px solid var(--line);min-height:54px}
.bar-title{flex:1;min-width:0;display:flex;align-items:baseline;gap:10px}
.bar-title .no{flex:none;font-size:13px;font-weight:700;color:var(--pen);font-variant-numeric:tabular-nums}
.bar-title h2{min-width:0;font-size:17px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar-act{display:flex;gap:6px}
.menu{display:none}
.content{position:relative;min-height:0;overflow:hidden}
.view{position:absolute;inset:0;z-index:2;overflow:auto;padding:28px clamp(16px,3vw,40px) 56px;background:var(--paper)}
.stage{position:absolute;inset:0;z-index:1;background:#fff}
.stage iframe{position:absolute;inset:0;width:100%;height:100%;border:0;background:#fff;visibility:hidden}
.stage iframe.on{visibility:visible}
.loading{position:absolute;inset:0;display:grid;place-items:center;color:var(--ink2);z-index:2;font-size:15px;background:#fff}
@media(max-width:900px){
  .app{grid-template-columns:minmax(0,1fr)}
  .side{position:fixed;inset:0 auto 0 0;width:min(320px,88vw);z-index:40;transform:translateX(-102%);transition:transform .2s ease}
  .app.drawer .side{transform:none}
  .scrim{position:fixed;inset:0;background:rgba(22,32,42,.4);z-index:39}
  .menu{display:inline-flex}
  .bar{padding:8px 10px}
}
@media(max-width:600px){#btn-full,#btn-reload{display:none}.bar-title .no{display:none}}

/* ---------- beranda ---------- */
.head{max-width:1100px}
.head h1{font-size:28px;font-weight:800;letter-spacing:-.015em;line-height:1.15}
.head p{color:var(--ink2);margin-top:6px;max-width:72ch}
.notice{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;border:1px solid #E5C66E;background:var(--warn-soft);color:var(--warn);padding:11px 14px;margin-top:18px;max-width:1100px;font-size:14px}
.notice b{color:var(--ink)}
.register{max-width:1100px;margin-top:24px;border:1px solid var(--ink);background:#fff;overflow:auto}
.register table{width:100%;border-collapse:collapse}
.register th,.register td{padding:11px 14px;text-align:left;vertical-align:top}
.register thead th{font-size:12.5px;color:var(--ink2);font-weight:600;border-bottom:1px solid var(--ink);background:#F7F9FA}
.register tr.gh th{font-size:14.5px;font-weight:800;border-top:1px solid var(--ink);background:var(--paper)}
.register tr.gh:first-child th{border-top:0}
.register tr.gh th span{font-weight:400;color:var(--ink2);font-size:13px;margin-left:8px}
.register tr.r td{border-top:1px solid var(--line2);cursor:pointer}
.register tr.r:hover td{background:#FBFCF8}
.register td.no{width:58px;font-weight:800;font-size:19px;color:var(--pen);font-variant-numeric:tabular-nums;padding-top:9px}
.register .t{font-weight:700;font-size:15.5px}
.register .d{color:var(--ink2);font-size:13.5px;margin-top:2px;max-width:72ch}
.register td.std{font-size:13px;color:var(--ink2);width:210px}
.register td.go{width:96px;text-align:right}
@media(max-width:760px){.register td.std,.register thead th.std{display:none}.register td.go{display:none}}

/* ---------- kelola akun ---------- */
.adm{max-width:1180px;display:grid;grid-template-columns:minmax(0,1fr);gap:22px}
.strip{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border:1px solid var(--ink);background:#fff;margin:0}
.strip>div{padding:10px 14px;border-left:1px solid var(--ink);min-width:0}
.strip>div:first-child{border-left:0}
.strip dt{font-size:12px;color:var(--ink2)}
.strip dd{margin:2px 0 0;font-size:21px;font-weight:800;line-height:1.2}
.strip dd.txt{font-size:15px;padding-top:4px}
.strip dd.warn{color:var(--warn)}
.strip dd.ok{color:var(--ok)}
.cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;align-items:start}
.panel{background:#fff;border:1px solid var(--line);min-width:0}
.panel>header{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid var(--line)}
.panel>header h3{font-size:16px;font-weight:800}
.panel>header p{font-size:13px;color:var(--ink2)}
.pb{padding:16px;display:grid;gap:12px}
.pb h4{font-size:14.5px;font-weight:800}
.sep{border-top:1px solid var(--line2);padding-top:14px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.tools{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid var(--line)}
.tools .inp{max-width:340px}
.tools .sp{flex:1}
.tbl{overflow:auto;max-height:70vh}
.tbl table{width:100%;border-collapse:collapse;font-size:14px;min-width:1040px}
.tbl th{font-size:12.5px;color:var(--ink2);font-weight:600;text-align:left;padding:8px 12px;border-bottom:1px solid var(--ink);background:#F7F9FA;position:sticky;top:0;z-index:1}
.tbl td{padding:9px 12px;border-bottom:1px solid var(--line2);vertical-align:middle}
.tbl td.r,.tbl th.r{text-align:right}
.tbl .self{font-size:12px;color:var(--ink2);margin-left:6px}
.tbl .empty{padding:24px 16px;color:var(--ink2);text-align:center}
.role{display:inline-block;font-size:12px;font-weight:700;padding:1px 9px;border-radius:999px;background:var(--pen-soft);color:var(--pen2)}
.role.a{background:var(--mark-soft);color:#6B4E00}
.pwc{display:flex;gap:6px;align-items:center}
.pwc .cred{min-width:84px}
.acts{display:flex;gap:6px;justify-content:flex-end;flex-wrap:nowrap}
details summary{cursor:pointer;font-size:14px;color:var(--ink2)}
details[open] summary{margin-bottom:8px}
@media(max-width:1020px){.cols{grid-template-columns:minmax(0,1fr)}.strip{grid-template-columns:repeat(3,minmax(0,1fr))}.strip>div:nth-child(4){border-left:0}.strip>div:nth-child(n+4){border-top:1px solid var(--ink)}}
@media(max-width:560px){.grid2{grid-template-columns:1fr}.strip{grid-template-columns:1fr 1fr}.strip>div{border-left:0!important;border-top:1px solid var(--ink)}.strip>div:nth-child(-n+2){border-top:0}.strip>div:nth-child(even){border-left:1px solid var(--ink)!important}.strip>div:last-child{grid-column:1/-1}}

/* ---------- dialog & toast ---------- */
dialog{border:2px solid var(--ink);border-radius:0;padding:0;width:min(520px,calc(100vw - 28px));color:var(--ink);background:#fff}
dialog::backdrop{background:rgba(22,32,42,.45)}
dialog header{padding:14px 18px;border-bottom:1px solid var(--ink)}
dialog header h3{font-size:17px;font-weight:800}
dialog .db{padding:16px 18px;display:grid;gap:12px;max-height:65vh;overflow:auto}
dialog footer{display:flex;justify-content:flex-end;gap:8px;flex-wrap:wrap;padding:12px 18px;border-top:1px solid var(--line)}
.credbox{border:1px dashed var(--ink2);padding:12px 14px;background:var(--paper);font-family:var(--mono);font-size:14px;line-height:1.7;white-space:pre-wrap;word-break:break-word}
#toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 16px;border-radius:4px;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:100;max-width:calc(100vw - 28px)}
#toast.on{opacity:1}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
.tbl .cred{white-space:nowrap}
</style>
</head>
<body>
<noscript><p style="padding:24px;font:16px sans-serif">File ini membutuhkan JavaScript. Buka dengan Chrome, Edge, Firefox, atau Safari versi terbaru.</p></noscript>
<script type="text/html" id="lhs-ui">
<div id="v-login" class="login mm">
