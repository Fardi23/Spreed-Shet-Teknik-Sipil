  </form>
</div>

<div id="v-app" class="app" hidden>
  <aside class="side" id="side" aria-label="Daftar kalkulator">
    <div class="brand">
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="3" fill="#1E4F8F"/><path d="M6 10.5H26" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/><path d="M6 14.5Q16 30 26 14.5" fill="none" stroke="#F3C84B" stroke-width="2.2" stroke-linecap="round"/></svg>
      <div><b>Lembar Hitung Sipil</b><span>Kalkulator teknik sipil</span></div>
    </div>
    <div class="side-top">
      <button type="button" class="home-link" data-go="home">Beranda</button>
      <input class="inp" id="q" type="search" placeholder="Cari kalkulator" aria-label="Cari kalkulator">
    </div>
    <nav id="nav"></nav>
    <div class="me">
      <div class="me-id"><b id="me-name"></b><span id="me-sub"></span></div>
      <div class="row">
        <button type="button" class="btn sm" id="btn-admin" data-go="admin" hidden>Kelola akun</button>
        <button type="button" class="btn sm" id="btn-logout">Keluar</button>
      </div>
    </div>
  </aside>
  <div class="scrim" id="scrim" hidden></div>
  <main class="main">
    <header class="bar">
      <button type="button" class="btn ghost menu" id="btn-menu" aria-label="Buka daftar kalkulator" aria-controls="side">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
